# Build output
/dist/
/nanoasr
/nanoasr-*.tar.gz
/web/dist/
/web/node_modules/
/web/node_modules/.tmp/
# Playwright's run output: traces on failure, and a pointer to the last run.
/web/test-results/
/web/playwright-report/

# The SPA is staged here by `make web` and embedded at compile time. The
# placeholder page is committed so `go build` works in a fresh checkout.
/internal/ui/dist/*
!/internal/ui/dist/index.html

# Local state
/.models/
# Audio is fetched by scripts/fetch-testdata.sh: it has its own licensing and
# every derived form is reproducible. The golden transcript IS committed.
/testdata/audio/
/.nanoasr.db*
*.db-wal
*.db-shm
/configs/nanoasr.local.yaml

# Tooling
*.test
*.out
.DS_Store
